<div class="modal" id="projectModal" hidden>
    <div class="modal-backdrop" data-action="close-modal" data-modal="projectModal"></div>
    <section class="dialog project-dialog" role="dialog" aria-modal="true" aria-labelledby="projectModalTitle">
        <div class="dialog-heading">
            <div><span class="eyebrow">PLAN THE BIGGER PICTURE</span>
                <h2 id="projectModalTitle">Create a project</h2>
            </div><button class="icon-button" type="button" data-action="close-modal" data-modal="projectModal"
                aria-label="Close dialog"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <form id="projectForm" action="/projects" method="post">
            <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
            <div class="form-field"><label for="projectName">Project name <span>*</span></label><input id="projectName"
                    name="name" required maxlength="120" placeholder="e.g. Website refresh"></div>
            <div class="form-field"><label for="projectDescription">Description</label><textarea id="projectDescription"
                    name="description" rows="3" maxlength="1000"
                    placeholder="What does this project aim to accomplish?"></textarea></div>
            <div class="project-form-grid">
                <div class="form-field"><label for="projectStatus">Status</label><select id="projectStatus"
                        name="status">
                        <option value="Planning">Planning</option>
                        <option value="In progress">In progress</option>
                        <option value="Completed">Completed</option>
                    </select></div>
                <div class="form-field"><label for="projectStartDate">Start date</label><input id="projectStartDate"
                        name="startDate" type="date"></div>
                <div class="form-field"><label for="projectDueDate">Due date</label><input id="projectDueDate"
                        name="dueDate" type="date"></div>
                <div class="form-field field-full"><label for="projectMembers">Project members</label><select
                        id="projectMembers" name="members" multiple size="5" aria-describedby="projectMembersHelp">
                        <% memberChoices.forEach(function(member) { %>
                            <option value="<%= member.id %>">
                                <%= member.name %> (<%= member.email %>)
                            </option>
                            <% }); %>
                    </select><small id="projectMembersHelp">Use Ctrl or Command to select multiple members. You are
                        always included as the project owner.</small></div>
            </div>
            <div class="dialog-actions"><button class="button button-quiet" type="button" data-action="close-modal"
                    data-modal="projectModal">Cancel</button><button class="button button-primary" type="submit"><i
                        class="fa-solid fa-check"></i> <span id="projectSubmitLabel">Create project</span></button>
            </div>
        </form>
    </section>
</div>