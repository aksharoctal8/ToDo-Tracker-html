<%- include("partials/header") %>
<%- include("partials/sidebar") %>
<section class="app-view active" id="view-dashboard" data-page-title="Dashboard">
    <div class="page-heading"><div><span class="eyebrow">YOUR WORKSPACE AT A GLANCE</span><h1><%= greeting %>, <span id="dashboardName"><%= user.name.split(" ")[0] %></span></h1><p>Here's a snapshot of your workspace today.</p></div><button class="button button-primary" type="button" data-action="add-task"><i class="fa-solid fa-plus"></i> Add task</button></div>
    <div class="stats-grid">
        <article class="stat-card"><span class="stat-icon stat-icon-indigo"><i class="fa-solid fa-layer-group"></i></span><span class="stat-label">Total tasks</span><strong id="statTotal"><%= stats.total %></strong><small class="stat-foot">Across your workspace</small></article>
        <article class="stat-card"><span class="stat-icon stat-icon-green"><i class="fa-solid fa-circle-check"></i></span><span class="stat-label">Completed</span><strong id="statCompleted"><%= stats.completed %></strong><small class="stat-foot">Nice work so far</small></article>
        <article class="stat-card"><span class="stat-icon stat-icon-blue"><i class="fa-solid fa-spinner"></i></span><span class="stat-label">In progress</span><strong id="statProgress"><%= stats.inProgress %></strong><small class="stat-foot">Currently in motion</small></article>
        <article class="stat-card"><span class="stat-icon stat-icon-amber"><i class="fa-regular fa-clock"></i></span><span class="stat-label">Pending</span><strong id="statPending"><%= stats.pending %></strong><small class="stat-foot">Ready when you are</small></article>
        <article class="stat-card"><span class="stat-icon stat-icon-rose"><i class="fa-solid fa-triangle-exclamation"></i></span><span class="stat-label">Overdue</span><strong id="statOverdue"><%= stats.overdue %></strong><small class="stat-foot">Needs a little attention</small></article>
        <article class="stat-card"><span class="stat-icon stat-icon-indigo"><i class="fa-solid fa-folder-open"></i></span><span class="stat-label">Total projects</span><strong><%= stats.totalProjects %></strong><small class="stat-foot">Projects you can access</small></article>
        <article class="stat-card"><span class="stat-icon stat-icon-blue"><i class="fa-solid fa-list-check"></i></span><span class="stat-label">Active projects</span><strong><%= stats.activeProjects %></strong><small class="stat-foot">Not marked completed</small></article>
        <article class="stat-card"><span class="stat-icon stat-icon-green"><i class="fa-solid fa-chart-pie"></i></span><span class="stat-label">Overall completion</span><strong><%= stats.overallCompletionPercentage %>%</strong><small class="stat-foot">Completed tasks / all tasks</small></article>
    </div>
    <div class="dashboard-grid">
        <article class="panel productivity-panel"><div class="panel-heading"><div><h2>Your productivity</h2><p>A little progress adds up.</p></div><span class="panel-menu-label"><i class="fa-solid fa-arrow-trend-up"></i> All time</span></div><div class="productivity-body"><div class="progress-ring" id="productivityRing" style="--progress:<%= stats.overallCompletionPercentage %>%"><div><strong id="productivityPercent"><%= stats.overallCompletionPercentage %>%</strong><small>complete</small></div></div><div class="productivity-copy"><b id="productivityMessage"><%= stats.completed ? "Look at you go." : "A fresh start." %></b><p id="productivitySummary"><%= stats.completed ? `${stats.completed} ${stats.completed === 1 ? "task is" : "tasks are"} complete. ${weeklyCompletion.reduce((total, day) => total + day.completed, 0)} completed in the last 7 days.` : "Every task is a chance to make progress." %></p><div class="legend-list"><span><i class="legend-dot legend-complete"></i> Completed <b id="legendCompleted"><%= stats.completed %></b></span><span><i class="legend-dot legend-open"></i> Still open <b id="legendOpen"><%= stats.total - stats.completed - stats.cancelled %></b></span></div></div></div></article>
        <article class="panel focus-panel"><div class="panel-heading"><div><h2>Keep your focus</h2><p>Small steps, steady momentum.</p></div><span class="focus-spark"><i class="fa-solid fa-bolt"></i></span></div><div class="focus-tip"><span class="focus-tip-icon"><i class="fa-solid fa-bullseye"></i></span><div><b>Make today count</b><p>Pick one important task and give it your attention.</p></div></div><button class="button button-outline button-small" type="button" data-action="add-task">Create a task <i class="fa-solid fa-arrow-right"></i></button></article>
        <article class="panel recent-panel"><div class="panel-heading"><div><h2>Recent tasks</h2><p>Your latest work at a glance.</p></div><a class="text-button" href="/tasks">See all <i class="fa-solid fa-arrow-right"></i></a></div><div class="task-table" id="recentTasks">
            <% tasks.slice(0,5).forEach(function(task) { %>
                <div class="task-row"><div class="task-row-main"><form action="/tasks/<%= task.id %>/status" method="post"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="status" value="<%= task.status === 'completed' ? 'pending' : 'completed' %>"><button class="task-check <%= task.status === 'completed' ? 'is-complete' : '' %>" type="submit" aria-label="Toggle completion for <%= task.title %>" aria-pressed="<%= task.status === 'completed' %>"><% if(task.status === "completed"){ %><i class="fa-solid fa-check"></i><% } %></button></form><span><span class="task-row-title"><a href="/tasks/<%= task.id %>"><%= task.title %></a></span><small class="task-row-meta"><%= task.projectName || task.category || "Personal task" %></small></span></div><span class="status-badge <%= task.overdue ? 'status-overdue' : `status-${task.status}` %>"><%= task.overdue ? "Overdue" : task.status === "progress" ? "In progress" : task.status[0].toUpperCase() + task.status.slice(1) %></span><span class="task-row-date"><%= task.dueDate || "No due date" %></span></div>
            <% }); %>
        </div></article>
        <article class="panel project-progress-panel"><div class="panel-heading"><div><h2>Recent projects</h2><p>Latest updates and completion progress.</p></div><a class="text-button" href="/projects">All projects <i class="fa-solid fa-arrow-right"></i></a></div><div id="dashboardProjects">
            <% if (projects.length) { projects.slice(0,3).forEach(function(project) { %>
                <div class="project-progress-item"><div class="project-progress-top"><span class="project-name-wrap"><span class="project-color-mark"><i class="fa-solid fa-folder-open"></i></span><b><%= project.name %></b></span><span><%= project.progress %>%</span></div><div class="progress-track" role="progressbar" aria-label="<%= project.name %> completion" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= project.progress %>"><span style="width:<%= project.progress %>%"></span></div><div class="project-progress-meta"><span><%= project.completedTaskCount %> of <%= project.taskCount %> tasks complete</span><span>Updated <%= project.updatedAt ? new Intl.DateTimeFormat("en", { month: "short", day: "numeric" }).format(new Date(project.updatedAt)) : "recently" %></span></div></div>
            <% }); } else { %><div class="task-empty-state"><i class="fa-solid fa-folder-plus"></i><h3>No projects yet</h3><p>Create your first project to track progress here.</p><a class="button button-outline button-small" href="/projects">Go to projects</a></div><% } %>
        </div></article>
    </div>
</section>
</main></div></div>
<%- include("partials/task-modal") %>
<%- include("partials/notifications") %>
<%- include("partials/footer") %>
