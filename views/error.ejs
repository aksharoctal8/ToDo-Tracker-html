<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#f5f7fb">
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <main class="auth-page">
        <section class="dialog auth-dialog auth-page-card">
            <div class="dialog-heading"><a class="brand" href="/"><span class="brand-mark"><i class="fa-solid fa-check"></i></span><span>TaskFlow</span></a></div>
            <div class="auth-intro"><h1><%= statusCode %></h1><p><%= message %></p></div>
            <a class="button button-primary button-full" href="/">Return to TaskFlow</a>
        </section>
    </main>
</body>
</html>
